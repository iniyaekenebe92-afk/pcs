<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
<script>
  // Shared render helpers for Tom Select country fields
  function renderCountryOption(data, escape) {
    const iso = escape(data.iso || '');
    const label = escape(data.text);
    const flag = iso
      ? `<img src="https://flagcdn.com/20x15/${iso}.png" width="20" height="15" alt="" loading="lazy" />`
      : '';
    return `<div>${flag} ${label}</div>`;
  }

  function renderCountryItem(data, escape) {
    const iso = escape(data.iso || '');
    const label = escape(data.text);
    const flag = iso
      ? `<img src="https://flagcdn.com/20x15/${iso}.png" width="20" height="15" alt="" style="display:inline;vertical-align:middle;margin-right:6px;border-radius:2px;" loading="lazy" />`
      : '';
    return `<div>${flag}${label}</div>`;
  }

  ['nationality', 'current_country', 'current_occupation'].forEach(function(id) {
    const el = document.getElementById(id);
    if (!el) return;

    // Build items array from <option> elements so Tom Select has the iso code
    const options = Array.from(el.options).slice(1).map(function(opt) {
      return { value: opt.value, text: opt.text, iso: opt.dataset.iso || '' };
    });

    const isOccupation = id === 'current_occupation';
    new TomSelect(el, {
      options: options,
      items: el.value ? [el.value] : [],
      valueField: 'value',
      labelField: 'text',
      searchField: 'text',
      placeholder: isOccupation ? 'Search occupation…' : 'Search country…',
      maxOptions: isOccupation ? null : 300,
      create: isOccupation,
      createOnBlur: false,
      render: {
        option: renderCountryOption,
        item: renderCountryItem,
        option_create: isOccupation ? function(data, escape) {
          return '<div class="create ts-occupation-create"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;flex-shrink:0"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/><path d="M9 12h6"/><path d="M12 9v6"/></svg> Use \"' + escape(data.input) + '\"</div>';
        } : null,
        no_results: isOccupation ? function(data, escape) {
          return '<div class="no-results" style="padding:0.5rem 0.875rem">No results found for “' + escape(data.input) + '”</div>';
        } : null,
      },
      onInitialize: function() {
        const icon = document.createElement('span');
        icon.className = 'ts-search-icon';
        icon.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/><path d="M21 21l-6 -6"/></svg>';
        this.control.prepend(icon);
      },
      onChange: function(val) {
        const err = document.getElementById('err-' + id);
        if (err) err.classList.remove('visible');
        if (this.wrapper) {
          this.wrapper.classList.remove('error');
          this.wrapper.classList.toggle('has-value', !!val);
        }
      },
    });
  });
</script>

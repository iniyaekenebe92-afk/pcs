              </span>
            </label>
            <p class="field-error" id="err-consented">You must agree to the consent statement.</p>
            <input type="hidden" id="consented-hidden" name="consented" value="false" />
          </div>

        </div>

        <!-- Form navigation -->
        <div class="pt-6 pb-2 flex items-center gap-3">
          <button type="button" id="btn-prev" class="btn-secondary flex-shrink-0" style="display:none;background:#1e293b;color:#fff;">

              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l14 0"/><path d="M15 16l4 -4"/><path d="M15 8l4 4"/></svg>
            </span>
          </button>
          <button type="submit" id="btn-submit" class="btn-primary min-w-0 flex-shrink flex-grow" style="display:none">
            <span class="flex items-center justify-center gap-2">
              <span id="submit-label">Submit</span>
              <span id="submit-spinner" class="spinner ml-1" style="display:none"></span>
            </span>
          </button>
        </div>
      </form>
    </div>



    <!-- Error banner -->
    <div id="error-banner" class="hidden mt-4 p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm text-center"></div>

  </div>
</section>


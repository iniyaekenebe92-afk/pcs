    ['zw','263','Zimbabwe'],
  ];

  let selected = COUNTRIES.find(c => c[0] === 'ng');
  const dialBtn    = document.getElementById('dial-btn');
  const dialFlag   = document.getElementById('dial-flag');
  const dialCode   = document.getElementById('dial-code');
  const dialChev   = document.getElementById('dial-chevron');
  const dialMenu   = document.getElementById('dial-menu');
  const dialSearch = document.getElementById('dial-search');
  const dialList   = document.getElementById('dial-list');
  const numberInp  = document.getElementById('whatsapp-number');
  const hidden     = document.getElementById('whatsapp');
  const phoneField = document.getElementById('phone-field');

  function flagUrl(iso) {
    return `https://flagcdn.com/20x15/${iso}.png`;
  }

  function syncHidden() {
    const num = numberInp.value.replace(/\D/g, '');
    hidden.value = num ? '+' + selected[1] + num : '';
  }

  function renderList(filter) {
    const q = (filter || '').toLowerCase();
    const items = COUNTRIES.filter(c =>
      !q || c[2].toLowerCase().includes(q) || c[1].includes(q)
    );
    dialList.innerHTML = items.map(c => `
      <li role="option" class="dial-item${c[0] === selected[0] ? ' selected' : ''}" data-iso="${c[0]}">
        <img src="${flagUrl(c[0])}" width="20" height="14" alt="" loading="lazy" />
        <span>${c[2]}</span>
        <span class="dial-item-code">+${c[1]}</span>
      </li>`).join('');
  }

  function openMenu() {
    const r = phoneField.getBoundingClientRect();
    dialMenu.style.top   = (r.bottom + 4) + 'px';
    dialMenu.style.left  = r.left + 'px';
    dialMenu.style.width = r.width + 'px';
    dialMenu.classList.remove('hidden');
    dialBtn.setAttribute('aria-expanded', 'true');
    dialChev.style.transform = 'rotate(180deg)';
    dialSearch.value = '';
    renderList('');
    dialSearch.focus();
  }

  function closeMenu() {
    dialMenu.classList.add('hidden');
    dialBtn.setAttribute('aria-expanded', 'false');
    dialChev.style.transform = '';
  }

  function selectCountry(iso) {
    selected = COUNTRIES.find(c => c[0] === iso) || selected;
    dialFlag.src = flagUrl(selected[0]);
    dialFlag.alt = selected[2];
    dialCode.textContent = '+' + selected[1];
    syncHidden();
    closeMenu();
  }

  dialBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    dialMenu.classList.contains('hidden') ? openMenu() : closeMenu();
  });

  dialSearch.addEventListener('input', () => renderList(dialSearch.value));

  dialList.addEventListener('click', (e) => {
    const item = e.target.closest('.dial-item');
    if (item) selectCountry(item.dataset.iso);
  });

  numberInp.addEventListener('input', () => {
    syncHidden();
    // clear error on type
    document.getElementById('err-whatsapp').classList.remove('visible');
    phoneField.classList.remove('error');
  });

  // Reposition on scroll/resize
  function reposition() {
    if (!dialMenu.classList.contains('hidden')) {
      const r = phoneField.getBoundingClientRect();
      dialMenu.style.top  = (r.bottom + 4) + 'px';
      dialMenu.style.left = r.left + 'px';
    }
  }
  window.addEventListener('scroll', reposition, { passive: true });
  window.addEventListener('resize', reposition, { passive: true });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!dialMenu.contains(e.target) && e.target !== dialBtn && !dialBtn.contains(e.target)) {
      closeMenu();
    }
  });

  // Init hidden field
  syncHidden();
})();
